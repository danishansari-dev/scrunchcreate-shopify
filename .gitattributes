# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.liquid text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary media files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
