{% comment %}
  Scrunch & Create - Discover Collections Section
  Why: Replicates the category cards with image overlays and description from features/products/components/CollectionsSection/
{% endcomment %}

<div class="sc-collections-section">
  <div class="page-width">
    <div class="sc-section-header">
      <div class="sc-section-title-wrap">
        <h2 class="sc-section-title">{{ section.settings.heading | default: "Discover Our Collections" }}</h2>
        <p class="sc-section-subtitle">{{ section.settings.subheading | default: "Handmade for every occasion" }}</p>
      </div>
    </div>

    <div class="sc-collections-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col_url = block.settings.collection.url | default: block.settings.link | default: routes.all_products_collection_url
          assign col_title = block.settings.collection.title | default: block.settings.title
          assign col_desc = block.settings.desc
          assign col_img = block.settings.image
        -%}

        <a href="{{ col_url }}" class="sc-col-card" {{ block.shopify_attributes }}>
          <div class="sc-col-img-wrap">
            {%- if col_img != blank -%}
              <img
                src="{{ col_img | image_url: width: 600 }}"
                alt="{{ col_title | escape }}"
                loading="lazy"
                width="600"
                height="450"
                class="sc-col-img"
              >
            {%- elsif block.settings.image_url != blank -%}
              <img
                src="{{ block.settings.image_url }}"
                alt="{{ col_title | escape }}"
                loading="lazy"
                width="600"
                height="450"
                class="sc-col-img"
              >
            {%- else -%}
              <div class="sc-col-placeholder">🎀</div>
            {%- endif -%}
            <div class="sc-col-overlay">
              <h3 class="sc-col-name">{{ col_title }}</h3>
              {%- if block.settings.badge != blank -%}
                <span class="sc-col-badge">{{ block.settings.badge }}</span>
              {%- endif -%}
            </div>
          </div>
          {%- if col_desc != blank -%}
            <div class="sc-col-body">
              <p class="sc-col-desc">{{ col_desc }}</p>
            </div>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scrunch Collections Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Our Collections"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Handmade for every occasion"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Scrunchies"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Count / Badge",
          "default": "24 styles"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Luxurious fabric scrunchies that care for your hair"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Direct Image URL (Fallback)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrunch Collections Grid",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "title": "Scrunchies",
            "badge": "24 styles",
            "desc": "Luxurious fabric scrunchies that care for your hair",
            "image_url": "https://res.cloudinary.com/duu26sqog/image/upload/v1775597198/scrunchcreate/products/scrunchie/classic/brown/sc-scrunchie-classic-brown-1.webp",
            "link": "/collections/all"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Hair Bows",
            "badge": "18 styles",
            "desc": "Elegant bows for a sophisticated touch",
            "image_url": "https://res.cloudinary.com/duu26sqog/image/upload/v1775597148/scrunchcreate/products/hairbow/satin/black/sc-hairbow-satin-black-1.webp",
            "link": "/collections/all"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Hairclips",
            "badge": "12 styles",
            "desc": "Elegant clips for a stylish look",
            "image_url": "https://res.cloudinary.com/duu26sqog/image/upload/v1775597566/scrunchcreate/products/hairclip/rose/red/sc-hairclip-rose-red-1.webp",
            "link": "/collections/all"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Gift Hampers",
            "badge": "12 styles",
            "desc": "Curated gift sets for your loved ones",
            "image_url": "https://res.cloudinary.com/duu26sqog/image/upload/v1775597038/scrunchcreate/products/gifthamper/sc-gifthamper-1.webp",
            "link": "/collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
