{% comment %}
  Scrunch & Create - Hero Banner Carousel
  Why: Renders responsive desktop widescreen banners and dedicated studio-designed mobile portrait banners with seamless touch swiping, accessible navigation, and Shopify Theme Customizer lifecycle support.
{% endcomment %}

<div class="sc-hero-banner-wrapper" data-section-id="{{ section.id }}" data-autoplay="{{ section.settings.autoplay | default: 4500 }}">
  <!-- Desktop Carousel View (Hidden on mobile <= 767px) -->
  <div class="sc-desktop-carousel">
    <div class="sc-carousel-track">
      {%- for block in section.blocks -%}
        {%- liquid
          assign default_d_slide = 'slider1.png'
          if forloop.index == 2
            assign default_d_slide = 'slider2.png'
          elsif forloop.index >= 3
            assign default_d_slide = 'slider3.png'
          endif

          assign slide_cta_url = block.settings.cta_link
          if slide_cta_url == blank
            if forloop.index == 2
              assign slide_cta_url = '/collections/gift-hampers'
            elsif forloop.index >= 3
              assign slide_cta_url = '/collections/scrunchies'
            else
              assign slide_cta_url = routes.all_products_collection_url
            endif
          endif
        -%}
        <div
          class="sc-carousel-slide {% if forloop.first %}is-active{% endif %}"
          data-slide-index="{{ forloop.index0 }}"
          data-block-id="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 2400 }}"
              alt="{{ block.settings.heading | default: 'Scrunch & Create' | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
              width="{{ block.settings.image.width | default: 2048 }}"
              height="{{ block.settings.image.height | default: 768 }}"
              class="sc-slide-img"
            >
          {%- else -%}
            <img
              src="{{ default_d_slide | asset_url }}"
              alt="{{ block.settings.heading | default: 'Scrunch & Create' | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
              width="2048"
              height="768"
              class="sc-slide-img"
            >
          {%- endif -%}

          <a href="{{ slide_cta_url }}" class="sc-slide-link" aria-label="{{ block.settings.heading | default: 'Shop Collection' }}"></a>
        </div>
      {%- endfor -%}
    </div>

    <!-- Desktop Navigation Buttons -->
    <button class="sc-nav-btn sc-prev-btn" aria-label="Previous slide">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button class="sc-nav-btn sc-next-btn" aria-label="Next slide">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <!-- Mobile Hero Banner (Visible only on mobile <= 767px) -->
  <div class="sc-mobile-hero-container">
    <div class="sc-mobile-track">
      {%- for block in section.blocks -%}
        {%- liquid
          assign default_m_slide = 'slider1-mobile.jpg'
          if forloop.index == 2
            assign default_m_slide = 'slider2-mobile.jpg'
          elsif forloop.index >= 3
            assign default_m_slide = 'slider3-mobile.jpg'
          endif

          assign mobile_cta_url = block.settings.cta_link
          if mobile_cta_url == blank
            if forloop.index == 2
              assign mobile_cta_url = '/collections/gift-hampers'
            elsif forloop.index >= 3
              assign mobile_cta_url = '/collections/scrunchies'
            else
              assign mobile_cta_url = routes.all_products_collection_url
            endif
          endif
        -%}
        <div
          class="sc-mobile-slide {% if forloop.first %}is-active{% endif %}"
          data-mobile-index="{{ forloop.index0 }}"
          data-block-id="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <a href="{{ mobile_cta_url }}" class="sc-mobile-slide-link" aria-label="{{ block.settings.heading | default: 'Explore Collection' }}">
            {%- if block.settings.image_mobile != blank -%}
              <img
                src="{{ block.settings.image_mobile | image_url: width: 1000 }}"
                alt="{{ block.settings.heading | default: 'Scrunch & Create' | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                width="{{ block.settings.image_mobile.width | default: 896 }}"
                height="{{ block.settings.image_mobile.height | default: 1200 }}"
                class="sc-mobile-slide-img"
              >
            {%- elsif block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1000 }}"
                alt="{{ block.settings.heading | default: 'Scrunch & Create' | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                width="{{ block.settings.image.width | default: 896 }}"
                height="{{ block.settings.image.height | default: 1200 }}"
                class="sc-mobile-slide-img"
              >
            {%- else -%}
              <img
                src="{{ default_m_slide | asset_url }}"
                alt="{{ block.settings.heading | default: 'Scrunch & Create' | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                width="896"
                height="1200"
                class="sc-mobile-slide-img"
              >
            {%- endif -%}
          </a>
        </div>
      {%- endfor -%}
    </div>

    <!-- Mobile Indicator Dots -->
    {%- if section.blocks.size > 1 -%}
      <div class="sc-mobile-dots" aria-label="Slide indicators">
        {%- for block in section.blocks -%}
          <button
            class="sc-dot {% if forloop.first %}is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  /**
   * Initializes the responsive Hero Banner carousel with touch swipe gestures for mobile
   * and binds Shopify Theme Customizer events.
   * @danishansari-dev userId - Admin/Theme author
   * @returns {void}
   */
  function initScrunchHeroBanner_{{ section.id | replace: '-', '_' }}() {
    const wrapper = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!wrapper) return;

    const desktopSlides = wrapper.querySelectorAll('.sc-carousel-slide');
    const mobileSlides = wrapper.querySelectorAll('.sc-mobile-slide');
    const mobileContainer = wrapper.querySelector('.sc-mobile-hero-container');
    const dots = wrapper.querySelectorAll('.sc-dot');
    const prevBtn = wrapper.querySelector('.sc-prev-btn');
    const nextBtn = wrapper.querySelector('.sc-next-btn');
    const count = desktopSlides.length;
    if (count <= 1) return;

    let current = 0;
    let timer = null;
    const interval = parseInt(wrapper.dataset.autoplay) || 4500;

    /**
     * Activates a specific slide index on both desktop and mobile views
     * @danishansari-dev userId - Admin
     * @param {number} idx - Target slide index
     * @returns {void}
     */
    function showSlide(idx) {
      current = ((idx % count) + count) % count;
      desktopSlides.forEach((s, i) => s.classList.toggle('is-active', i === current));
      mobileSlides.forEach((s, i) => s.classList.toggle('is-active', i === current));
      dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
    }

    // Expose slide switch handler for Shopify Theme Editor
    window.__scrunchShowSlide_{{ section.id | replace: '-', '_' }} = showSlide;

    /**
     * Starts or resets the automatic slide transition timer
     * @danishansari-dev userId - Admin
     * @returns {void}
     */
    function startTimer() {
      if (timer) clearInterval(timer);
      timer = setInterval(() => showSlide(current + 1), interval);
    }

    if (prevBtn) prevBtn.addEventListener('click', () => { showSlide(current - 1); startTimer(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { showSlide(current + 1); startTimer(); });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { showSlide(i); startTimer(); });
    });

    // Pause autoplay on mouse hover (desktop)
    wrapper.addEventListener('mouseenter', () => clearInterval(timer));
    wrapper.addEventListener('mouseleave', () => startTimer());

    // Touch Swipe Gesture Support for Mobile Devices
    if (mobileContainer) {
      let touchStartX = 0;
      let touchStartY = 0;
      let touchEndX = 0;
      let touchEndY = 0;
      const swipeThreshold = 40;

      mobileContainer.addEventListener('touchstart', function(e) {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
        clearInterval(timer);
      }, { passive: true });

      mobileContainer.addEventListener('touchend', function(e) {
        touchEndX = e.changedTouches[0].screenX;
        touchEndY = e.changedTouches[0].screenY;
        handleSwipeGesture();
        startTimer();
      }, { passive: true });

      /**
       * Evaluates touch delta to determine if horizontal swipe threshold was reached
       * @danishansari-dev userId - Admin
       * @returns {void}
       */
      function handleSwipeGesture() {
        const diffX = touchEndX - touchStartX;
        const diffY = touchEndY - touchStartY;

        // Ensure horizontal movement dominates vertical scroll
        if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > swipeThreshold) {
          if (diffX < 0) {
            // Swiped left -> Next slide
            showSlide(current + 1);
          } else {
            // Swiped right -> Previous slide
            showSlide(current - 1);
          }
        }
      }
    }

    startTimer();
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrunchHeroBanner_{{ section.id | replace: '-', '_' }});
  } else {
    initScrunchHeroBanner_{{ section.id | replace: '-', '_' }}();
  }

  // Shopify Theme Editor Live Integration
  document.addEventListener('shopify:section:load', function(e) {
    if (e.target.querySelector('[data-section-id="{{ section.id }}"]')) {
      initScrunchHeroBanner_{{ section.id | replace: '-', '_' }}();
    }
  });

  document.addEventListener('shopify:block:select', function(e) {
    const blockId = e.detail.blockId;
    const wrapper = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!wrapper) return;
    const targetSlide = wrapper.querySelector(`[data-block-id="${blockId}"]`);
    if (targetSlide) {
      const idx = parseInt(targetSlide.dataset.slideIndex || targetSlide.dataset.mobileIndex);
      if (!isNaN(idx) && window.__scrunchShowSlide_{{ section.id | replace: '-', '_' }}) {
        window.__scrunchShowSlide_{{ section.id | replace: '-', '_' }}(idx);
      }
    }
  });
</script>

{% schema %}
{
  "name": "Scrunch Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "autoplay",
      "min": 3000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "label": "Slide Duration",
      "default": 4500
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Slide Image (2048x768)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Slide Image (896x1200 / 3:4)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Slide Title / Alt Text",
          "default": "Scrunch & Create"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Slide Destination Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrunch Hero Banner",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "Handmade Hair Bows & Accessories",
            "cta_link": "/collections/all"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Curated Gift Hampers",
            "cta_link": "/collections/gift-hampers"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Artisanal Satin Scrunchies",
            "cta_link": "/collections/scrunchies"
          }
        }
      ]
    }
  ]
}
{% endschema %}
