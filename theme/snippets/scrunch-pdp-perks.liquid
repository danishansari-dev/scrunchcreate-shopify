{% comment %}
  Scrunch & Create - PDP Conversion Trust & Delivery Badges
  Why: Placed directly below Add-to-Cart and Buy-Now buttons to alleviate pre-purchase friction (shipping times, payment methods, returns).
{% endcomment %}

<div class="sc-pdp-perks-wrapper">
  <div class="sc-pdp-perks-grid">
    <div class="sc-pdp-perk-item">
      <div class="sc-perk-icon-wrap">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <div class="sc-perk-text">
        <strong class="sc-perk-title">Pan-India Delivery</strong>
        <span class="sc-perk-desc">Dispatched in 24–48h • Arrives in 3–5 days</span>
      </div>
    </div>

    <div class="sc-pdp-perk-item">
      <div class="sc-perk-icon-wrap">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="5" width="20" height="14" rx="2"></rect>
          <line x1="2" y1="10" x2="22" y2="10"></line>
        </svg>
      </div>
      <div class="sc-perk-text">
        <strong class="sc-perk-title">COD & Prepaid Options</strong>
        <span class="sc-perk-desc">Cash on Delivery & instant UPI available</span>
      </div>
    </div>

    <div class="sc-pdp-perk-item">
      <div class="sc-perk-icon-wrap">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </div>
      <div class="sc-perk-text">
        <strong class="sc-perk-title">100% Artisanal Handmade</strong>
        <span class="sc-perk-desc">Hand-sewn with love by women in India</span>
      </div>
    </div>

    <div class="sc-pdp-perk-item">
      <div class="sc-perk-icon-wrap">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 4 23 10 17 10"></polyline>
          <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
        </svg>
      </div>
      <div class="sc-perk-text">
        <strong class="sc-perk-title">7-Day Easy Replacement</strong>
        <span class="sc-perk-desc">Hassle-free replacement if damaged in transit</span>
      </div>
    </div>
  </div>
</div>
