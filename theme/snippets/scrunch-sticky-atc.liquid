{% comment %}
  Scrunch & Create - Mobile Sticky Add To Cart Bar
  Why: Mobile shoppers scrolling through lengthy product descriptions, reviews, and ingredient lists
  need a permanent, accessible Add-to-Cart call-to-action to maximize conversion rates.
  Features:
  - Appears automatically once user scrolls past the primary Add-to-Cart button on mobile (< 768px)
  - Dynamically updates with current variant price, availability, and title
  - Integrated 1-tap submission directly updating the Shopify cart and opening Cart Drawer
  - Respects modern iOS safe area insets (iPhone home indicator)
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_img = current_variant.featured_media | default: product.featured_media
-%}

<div
  id="sc-sticky-atc-bar"
  class="sc-sticky-atc"
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
  aria-hidden="true"
>
  <div class="sc-sticky-atc__inner">
    <div class="sc-sticky-atc__product-info">
      {%- if featured_img != blank -%}
        <div class="sc-sticky-atc__thumb-wrap">
          <img
            id="sc-sticky-atc-img"
            src="{{ featured_img | image_url: width: 120 }}"
            alt="{{ product.title | escape }}"
            width="52"
            height="52"
            loading="lazy"
            class="sc-sticky-atc__thumb"
          >
        </div>
      {%- endif -%}
      <div class="sc-sticky-atc__meta">
        <h4 class="sc-sticky-atc__title">{{ product.title | truncate: 26 }}</h4>
        <div class="sc-sticky-atc__price-row">
          <span id="sc-sticky-atc-price" class="sc-sticky-atc__price">
            {{ current_variant.price | money }}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span id="sc-sticky-atc-compare-price" class="sc-sticky-atc__compare-price">
              {{ current_variant.compare_at_price | money }}
            </span>
          {%- else -%}
            <span id="sc-sticky-atc-compare-price" class="sc-sticky-atc__compare-price" style="display: none;"></span>
          {%- endif -%}
          {%- unless product.has_only_default_variant -%}
            <span id="sc-sticky-atc-variant-name" class="sc-sticky-atc__variant-tag">
              {{ current_variant.title }}
            </span>
          {%- endunless -%}
        </div>
      </div>
    </div>

    <div class="sc-sticky-atc__action">
      <button
        id="sc-sticky-atc-btn"
        type="button"
        class="sc-sticky-atc__btn button button--primary"
        {% unless current_variant.available %}disabled{% endunless %}
        aria-label="{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}"
      >
        <span class="sc-sticky-atc__btn-text">
          {%- if current_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
        <span class="sc-sticky-atc__spinner" style="display: none;">
          <svg class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
            <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
          </svg>
        </span>
      </button>
    </div>
  </div>
</div>

<script>
  /**
   * Initializes the Mobile Sticky Add to Cart component with scroll observation and variant synchronization
   * @danishansari-dev userId - Admin/Theme author
   * @returns {void}
   */
  (function() {
    function initStickyAtc() {
      const stickyBar = document.getElementById('sc-sticky-atc-bar');
      if (!stickyBar) return;

      const mainAtcBtn = document.querySelector('.product-form__submit') || document.querySelector('[name="add"]');
      const stickyBtn = document.getElementById('sc-sticky-atc-btn');
      const stickyBtnText = stickyBar.querySelector('.sc-sticky-atc__btn-text');
      const stickySpinner = stickyBar.querySelector('.sc-sticky-atc__spinner');
      const stickyPrice = document.getElementById('sc-sticky-atc-price');
      const stickyComparePrice = document.getElementById('sc-sticky-atc-compare-price');
      const stickyVariantTag = document.getElementById('sc-sticky-atc-variant-name');
      const stickyImg = document.getElementById('sc-sticky-atc-img');

      // 1. Intersection Observer for Scroll Triggering
      if (mainAtcBtn) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            // Show sticky bar when main button is scrolled out of viewport
            if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
              stickyBar.classList.add('is-visible');
              stickyBar.setAttribute('aria-hidden', 'false');
            } else {
              stickyBar.classList.remove('is-visible');
              stickyBar.setAttribute('aria-hidden', 'true');
            }
          });
        }, {
          threshold: 0,
          rootMargin: '0px 0px 0px 0px'
        });

        observer.observe(mainAtcBtn);
      }

      // 2. Sync with Variant Change Events
      if (typeof subscribe !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined') {
        subscribe(PUB_SUB_EVENTS.optionValueSelectionChange, function(eventData) {
          setTimeout(syncVariantData, 150);
        });
      }

      /**
       * Synchronizes sticky ATC thumbnail, price, and variant title from main product form
       * @danishansari-dev userId - Admin
       * @returns {void}
       */
      function syncVariantData() {
        const variantInput = document.querySelector('.product-variant-id');
        const mainVariantSelects = document.querySelector('variant-selects');
        if (!mainVariantSelects) return;

        try {
          const rawVariant = mainVariantSelects.querySelector('[data-selected-variant]')?.textContent;
          if (rawVariant) {
            const variant = JSON.parse(rawVariant);
            if (variant) {
              if (stickyPrice && variant.price) {
                const formattedPrice = (variant.price / 100).toLocaleString('en-IN', {
                  style: 'currency',
                  currency: 'INR',
                  maximumFractionDigits: 0
                });
                stickyPrice.textContent = formattedPrice;
              }

              if (stickyComparePrice) {
                if (variant.compare_at_price && variant.compare_at_price > variant.price) {
                  const formattedCompare = (variant.compare_at_price / 100).toLocaleString('en-IN', {
                    style: 'currency',
                    currency: 'INR',
                    maximumFractionDigits: 0
                  });
                  stickyComparePrice.textContent = formattedCompare;
                  stickyComparePrice.style.display = 'inline';
                } else {
                  stickyComparePrice.style.display = 'none';
                }
              }

              if (stickyVariantTag && variant.title && variant.title !== 'Default Title') {
                stickyVariantTag.textContent = variant.title;
              }

              if (stickyBtn && stickyBtnText) {
                if (variant.available) {
                  stickyBtn.removeAttribute('disabled');
                  stickyBtnText.textContent = {{ 'products.product.add_to_cart' | t | json }};
                } else {
                  stickyBtn.setAttribute('disabled', 'disabled');
                  stickyBtnText.textContent = {{ 'products.product.sold_out' | t | json }};
                }
              }

              if (stickyImg && variant.featured_image && variant.featured_image.src) {
                stickyImg.src = variant.featured_image.src;
              }
            }
          }
        } catch (e) {
          console.warn('Sticky ATC sync error:', e);
        }
      }

      // 3. 1-Tap Add-To-Cart submission
      if (stickyBtn) {
        stickyBtn.addEventListener('click', function(e) {
          e.preventDefault();
          const mainForm = document.querySelector('product-form form') || document.querySelector('form[action*="/cart/add"]');
          if (mainForm) {
            // Trigger standard form submit to utilize Dawn's AJAX cart-drawer handler
            const submitBtn = mainForm.querySelector('[type="submit"]') || mainForm.querySelector('.product-form__submit');
            if (submitBtn) {
              submitBtn.click();
            } else {
              mainForm.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
            }
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyAtc);
    } else {
      initStickyAtc();
    }
  })();
</script>
