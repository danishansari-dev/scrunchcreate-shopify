<script>
  /**
   * Initializes Policy Hub tab switching and deep link URL hash handler
   * @why Allows users to jump directly to specific policies via URL hashes (#terms, #refund, etc.)
   */
  (function() {
    function initPolicyTabs() {
      const hub = document.getElementById('sc-policy-hub');
      if (!hub) return;

      const tabs = hub.querySelectorAll('.sc-policy-tab');
      const panels = hub.querySelectorAll('.sc-policy-panel');

      function activatePolicyTab(targetId) {
        if (!targetId) return;

        const cleanId = targetId.replace('#', '').toLowerCase();
        let matchedTab = null;

        tabs.forEach(tab => {
          const isMatch = tab.dataset.target === cleanId;
          tab.classList.toggle('is-active', isMatch);
          tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
          if (isMatch) matchedTab = tab;
        });

        panels.forEach(panel => {
          const panelId = panel.id.replace('policy-panel-', '');
          const isMatch = panelId === cleanId;
          panel.classList.toggle('is-active', isMatch);
          if (isMatch) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        });

        if (matchedTab && window.location.hash !== '#' + cleanId) {
          try {
            history.replaceState(null, null, '#' + cleanId);
          } catch(e) {}
        }
      }

      tabs.forEach(tab => {
        tab.addEventListener('click', function() {
          const target = this.dataset.target;
          activatePolicyTab(target);
        });
      });

      // Check initial URL pathname or hash
      const path = window.location.pathname.toLowerCase();
      const hash = window.location.hash.toLowerCase();

      if (hash && ['#terms', '#refund', '#shipping', '#privacy', '#contact'].includes(hash)) {
        activatePolicyTab(hash);
      } else if (path.includes('refund')) {
        activatePolicyTab('refund');
      } else if (path.includes('shipping')) {
        activatePolicyTab('shipping');
      } else if (path.includes('privacy')) {
        activatePolicyTab('privacy');
      } else if (path.includes('contact')) {
        activatePolicyTab('contact');
      } else if (path.includes('terms')) {
        activatePolicyTab('terms');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPolicyTabs);
    } else {
      initPolicyTabs();
    }
  })();
</script>
